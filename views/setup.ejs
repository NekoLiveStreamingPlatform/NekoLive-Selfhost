<%- include('partials/header') %>
  <div class="nl-auth-wrap">
    <h1>Set up your channel</h1>
    <p style="color: var(--muted); font-size: 0.85rem;">This runs once. Creates your admin account and your channel's name.</p>
    <% if (error) { %><div class="nl-error"><%= error %></div><% } %>
    <form method="POST" action="/setup">
      <div class="nl-field">
        <label class="nl-label">Your username</label>
        <input class="nl-input" type="text" name="username" required maxlength="40" />
      </div>
      <div class="nl-field">
        <label class="nl-label">Your email</label>
        <input class="nl-input" type="email" name="email" required maxlength="120" />
      </div>
      <div class="nl-field">
        <label class="nl-label">Password (min 8 characters)</label>
        <input class="nl-input" type="password" name="password" required minlength="8" />
      </div>
      <div class="nl-field">
        <label class="nl-label">Channel name</label>
        <input class="nl-input" type="text" name="channelName" required maxlength="40" placeholder="e.g. your-name" />
      </div>
      <button class="nl-btn" type="submit" style="width:100%;">Create account</button>
    </form>
  </div>
</body>
</html>
