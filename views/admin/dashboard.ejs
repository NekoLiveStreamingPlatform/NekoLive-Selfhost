<%- include('../partials/header') %>
  <div class="nl-nav">
    <span class="brand">Admin Dashboard</span>
    <span>
      <a class="nl-btn secondary" href="/">View channel</a>
      <form method="POST" action="/logout" style="display:inline;">
        <button class="nl-btn secondary" type="submit">Log out</button>
      </form>
    </span>
  </div>

  <div class="nl-admin-grid">
    <div class="nl-card">
      <h2>Channel info</h2>
      <% if (messages.channel) { %><div class="nl-error"><%= messages.channel %></div><% } %>
      <form method="POST" action="/admin/channel">
        <div class="nl-field">
          <label class="nl-label">Channel name</label>
          <input class="nl-input" type="text" name="channelName" value="<%= settings.channelName %>" maxlength="40" required />
        </div>
        <div class="nl-field">
          <label class="nl-label">Stream title</label>
          <input class="nl-input" type="text" name="channelTitle" value="<%= settings.channelTitle || '' %>" maxlength="140" />
        </div>
        <div class="nl-field">
          <label class="nl-label">Bio</label>
          <textarea class="nl-textarea" name="channelBio" rows="3" maxlength="500"><%= settings.channelBio || '' %></textarea>
        </div>
        <button class="nl-btn" type="submit">Save channel info</button>
      </form>
    </div>

    <div class="nl-card">
      <h2>Stream key</h2>
      <p style="color: var(--muted); font-size: 0.85rem;">
        Put this in your broadcast software's ingest URL — it's what OME's
        admission webhook checks incoming publishes against.
      </p>
      <div class="nl-field">
        <label class="nl-label">RTMP</label>
        <input class="nl-input" type="text" readonly value="rtmp://YOUR-OME-HOST/app/live?jwt=<%= settings.streamKey %>" onclick="this.select()" />
      </div>
      <div class="nl-field">
        <label class="nl-label">SRT</label>
        <input class="nl-input" type="text" readonly value="srt://YOUR-OME-HOST:9999?streamid=publish:app/live:<%= settings.streamKey %>" onclick="this.select()" />
      </div>
      <form method="POST" action="/admin/stream-key/regenerate" onsubmit="return confirm('This invalidates the current key immediately — anything still streaming with it will be cut off. Continue?');">
        <button class="nl-btn danger" type="submit">Regenerate stream key</button>
      </form>
    </div>

    <div class="nl-card">
      <h2>Your account</h2>
      <% if (messages.account) { %><div class="nl-error"><%= messages.account %></div><% } %>
      <form method="POST" action="/admin/account">
        <div class="nl-field">
          <label class="nl-label">Username</label>
          <input class="nl-input" type="text" name="username" value="<%= settings.ownerUsername %>" maxlength="40" />
        </div>
        <div class="nl-field">
          <label class="nl-label">Email</label>
          <input class="nl-input" type="email" name="email" value="<%= settings.ownerEmail %>" maxlength="120" />
        </div>
        <div class="nl-field">
          <label class="nl-label">New password (leave blank to keep current)</label>
          <input class="nl-input" type="password" name="newPassword" minlength="8" />
        </div>
        <div class="nl-field">
          <label class="nl-label">Current password (required to save any change here)</label>
          <input class="nl-input" type="password" name="currentPassword" required />
        </div>
        <button class="nl-btn" type="submit">Save account</button>
      </form>
    </div>

    <div class="nl-card full">
      <h2>Multistream</h2>
      <p style="color: var(--muted); font-size: 0.85rem;">
        Simulcasts this stream to any number of destinations (your own
        NekoLive channel, Twitch, YouTube, Kick, custom RTMP/SRT...) via
        your local OME node's Push Publishing — no re-encoding. Toggling a
        destination on/off here takes effect immediately, even mid-stream —
        it doesn't wait for you to go live/offline.
      </p>
      <div id="ms-error" class="nl-error" style="display:none;"></div>
      <table class="nl-table" style="margin-bottom: 1rem;">
        <thead><tr><th>Destination</th><th>Protocol</th><th>Status</th><th></th><th></th></tr></thead>
        <tbody id="ms-list"></tbody>
      </table>

      <form id="ms-add-form">
        <div class="nl-field">
          <label class="nl-label">Label</label>
          <input class="nl-input" id="ms-label" type="text" maxlength="60" placeholder="e.g. NekoLive, Twitch" required />
        </div>
        <div class="nl-field">
          <label class="nl-label">Protocol</label>
          <select class="nl-input" id="ms-protocol">
            <option value="rtmp">RTMP</option>
            <option value="srt">SRT</option>
            <option value="mpegts">MPEG-TS</option>
          </select>
        </div>
        <div class="nl-field">
          <label class="nl-label">Ingest URL</label>
          <input class="nl-input" id="ms-url" type="text" placeholder="rtmp://ingest.example.com/app/" required />
        </div>
        <div class="nl-field">
          <label class="nl-label">Stream key (optional, some protocols embed it in the URL instead)</label>
          <input class="nl-input" id="ms-key" type="password" />
        </div>
        <button class="nl-btn" type="submit">Add destination</button>
      </form>
    </div>

    <div class="nl-card">
      <h2>Ban list</h2>
      <p style="color: var(--muted); font-size: 0.85rem;">
        Blocks both chat and stream playback from this IP — they don't need
        any account for this to work.
      </p>
      <% if (messages.ban) { %><div class="nl-error"><%= messages.ban %></div><% } %>
      <form method="POST" action="/admin/ban" style="margin-bottom: 1rem;">
        <div class="nl-field">
          <label class="nl-label">IP address to ban</label>
          <input class="nl-input" type="text" name="ip" placeholder="1.2.3.4" required />
        </div>
        <div class="nl-field">
          <label class="nl-label">Reason (optional)</label>
          <input class="nl-input" type="text" name="reason" maxlength="200" />
        </div>
        <button class="nl-btn danger" type="submit">Ban IP</button>
      </form>

      <table class="nl-table">
        <thead><tr><th>IP</th><th>Reason</th><th>Banned</th><th></th></tr></thead>
        <tbody>
          <% bans.forEach(function(ban) { %>
            <tr>
              <td><%= ban.ip %></td>
              <td><%= ban.reason || '' %></td>
              <td><%= ban.createdAt.toISOString().slice(0, 10) %></td>
              <td>
                <form method="POST" action="/admin/ban/<%= ban.id %>/remove">
                  <button class="nl-btn secondary" type="submit">Unban</button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (!bans.length) { %>
            <tr><td colspan="4" style="color: var(--muted);">No bans yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="/js/admin.js"></script>
</body>
</html>
